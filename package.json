{
  "name": "comb",
  "version": "0.1.0",
  "private": true,
  "description": "Comb: BongoHive's internal finance paper trail. Requests, approvals, evidence and sealed records, upstream of Xero.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "demo": "COMB_DEMO=1 COMB_DB=data/demo.db node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "check:browser": "node scripts/browser-check.mjs",
    "reset-password": "node --disable-warning=ExperimentalWarning scripts/reset-password.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0"
  }
}
